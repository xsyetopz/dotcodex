{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "(^|[._])spawn_agent$|^spawn_agent$",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --no-install \"${CODEX_HOME:-$HOME/.codex}/hooks/enforce_spawn_policy.mjs\"",
						"timeout": 5,
						"statusMessage": "Applying subagent policy"
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "auto|manual",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --no-install \"${CODEX_HOME:-$HOME/.codex}/hooks/compact_checkpoint.mjs\"",
						"timeout": 8,
						"statusMessage": "Capturing task checkpoint"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "^(compact|startup|clear)$",
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --no-install \"${CODEX_HOME:-$HOME/.codex}/hooks/compact_checkpoint.mjs\"",
						"timeout": 5,
						"additionalContextLimit": 8000,
						"statusMessage": "Restoring task checkpoint"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun --no-env-file --no-install \"${CODEX_HOME:-$HOME/.codex}/hooks/compact_checkpoint.mjs\"",
						"timeout": 8,
						"statusMessage": "Saving session handoff"
					}
				]
			}
		]
	}
}
