{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "(^|[._])spawn_agent$|^spawn_agent$",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/enforce_spawn_policy.py\"",
						"timeout": 5,
						"statusMessage": "Applying subagent policy"
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": "auto|manual",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/compact_checkpoint.py\"",
						"timeout": 8,
						"statusMessage": "Capturing task checkpoint"
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "^compact$",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/compact_checkpoint.py\"",
						"timeout": 5,
						"statusMessage": "Restoring task checkpoint"
					}
				]
			}
		]
	}
}
